# Public — safe to expose to the browser
NEXT_PUBLIC_SANITY_PROJECT_ID=w6jr4lxx
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never prefix these with NEXT_PUBLIC_
# Viewer token: lets the website show unpublished drafts in Preview mode.
SANITY_API_READ_TOKEN=
# Editor token: used by `npm run seed` AND by the server-side admin bridge. Server-only; add it to Vercel.
SANITY_API_WRITE_TOKEN=
# Any long random string; must match the secret configured on the Sanity webhook.
SANITY_REVALIDATE_SECRET=

# Shared CMS login at /admin — generate the hash with: npm run admin:password -- "your password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH_B64=
SESSION_SECRET=
